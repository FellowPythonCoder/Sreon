{
  "name": "sreon-browser",
  "version": "1.0.0",
  "description": "Sreon — a quiet, privacy-focused desktop browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron electron/main.cjs",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.sreon.browser",
    "productName": "Sreon",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "public/**/*", "package.json"],
    "mac": { "target": ["dmg"], "icon": "public/brand/sreon.icns", "category": "public.app-category.utilities" },
    "win": { "target": ["nsis", "portable"], "icon": "public/brand/sreon.ico" },
    "linux": { "target": ["AppImage", "deb", "rpm"], "icon": "public/brand/icons", "category": "Network;WebBrowser;" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest"
  }
}
