~~ =====================================================================
~~  Sreon Browser Engine — URI Module
~~  Powered by SPRFST Language
~~
~~  Addresses, URL parsing, normalization, resolution, and search query
~~  detection.
~~ =====================================================================
module uri

pub object Url {
    scheme: Text = "https"
    host: Text = ""
    port: Int = 443
    path: Text = "/"
    query: Text = ""
    frag: Text = ""
    ok: Bool = false

    ~~ scheme://host[:port]
    fn origin(self) -> Text {
        if self.is_internal() { give self.scheme + "://" + self.host }
        var out = self.scheme + "://" + self.host
        if self.port != default_port(self.scheme) {
            out = out + ":" + self.port.to_text()
        }
        give out
    }

    ~~ The whole address, as typed or displayed
    fn full(self) -> Text {
        var out = if self.is_internal() and self.path == "/" {
            self.origin()
        } else {
            self.origin() + self.path
        }
        if self.query != "" { out = out + "?" + self.query }
        if self.frag != "" { out = out + "#" + self.frag }
        give out
    }

    fn target(self) -> Text {
        if self.query == "" { give self.path }
        give self.path + "?" + self.query
    }

    fn site(self) -> Text => strip_www(self.host)

    fn is_secure(self) -> Bool => self.scheme == "https"

    fn is_internal(self) -> Bool => self.scheme == "sreon" or self.scheme == "sprfst"
}

pub fn is_local(host: Text) -> Bool {
    give host == "localhost" or host == "127.0.0.1" or host == "::1" or
         host == "0.0.0.0" or host.ends_with(".local") or host.ends_with(".test") or
         host.starts_with("192.168.") or host.starts_with("10.") or
         host.starts_with("127.")
}

pub fn default_port(scheme: Text) -> Int {
    if scheme == "http" { give 80 }
    if scheme == "https" { give 443 }
    give 0
}

fn strip_www(host: Text) -> Text {
    if host.starts_with("www.") {
        give host.slice(4, host.len())
    }
    give host
}

~~ Parse a raw string into a structured Url object
pub fn parse(raw: Text) -> Url {
    var text = raw.trim()
    var u = Url { }
    if text == "" { give u }

    ~~ Frag
    let hash_idx = text.index_of("#")
    if hash_idx >= 0 {
        u.frag = text.slice(hash_idx + 1, text.len())
        text = text.slice(0, hash_idx)
    }

    ~~ Query
    let q_idx = text.index_of("?")
    if q_idx >= 0 {
        u.query = text.slice(q_idx + 1, text.len())
        text = text.slice(0, q_idx)
    }

    ~~ Scheme
    let colon_slash = text.index_of("://")
    if colon_slash >= 0 {
        u.scheme = text.slice(0, colon_slash).lower()
        text = text.slice(colon_slash + 3, text.len())
    } else if text.starts_with("sreon:") {
        u.scheme = "sreon"
        text = text.slice(6, text.len())
        if text.starts_with("//") { text = text.slice(2, text.len()) }
    } else if text.starts_with("sprfst:") {
        u.scheme = "sreon"
        text = text.slice(7, text.len())
        if text.starts_with("//") { text = text.slice(2, text.len()) }
    } else {
        u.scheme = "https"
    }

    ~~ Host and path
    let slash_idx = text.index_of("/")
    var authority = ""
    if slash_idx >= 0 {
        authority = text.slice(0, slash_idx)
        u.path = text.slice(slash_idx, text.len())
    } else {
        authority = text
        u.path = "/"
    }

    ~~ Port
    let port_idx = authority.index_of(":")
    if port_idx >= 0 {
        u.host = authority.slice(0, port_idx).lower()
        let port_str = authority.slice(port_idx + 1, authority.len())
        u.port = port_str.to_int() ?? default_port(u.scheme)
    } else {
        u.host = authority.lower()
        u.port = default_port(u.scheme)
    }

    if u.host != "" or u.is_internal() {
        u.ok = true
    }
    give u
}

~~ Detect if typed input is a search query or a valid destination URL
pub fn is_search(input: Text) -> Bool {
    let t = input.trim()
    if t.starts_with("http://") or t.starts_with("https://") or
       t.starts_with("sreon://") or t.starts_with("sprfst://") {
        give false
    }
    if t.contains(" ") { give true }
    if t.index_of(".") < 0 and not is_local(t) { give true }
    give false
}

~~ Turn typed text into an address, falling back to search engine query
pub fn tidy(input: Text, search_base: Text) -> Text {
    let t = input.trim()
    if t == "" { give "sreon://start" }
    if t.starts_with("sreon://") or t.starts_with("sprfst://") {
        give t.replace("sprfst://", "sreon://")
    }
    if t == "start" or t == "newtab" { give "sreon://start" }
    if t == "studio" or t == "ide" { give "sreon://studio" }
    if t == "whiteboard" { give "sreon://whiteboard" }
    if t == "shield" { give "sreon://shield" }
    if t == "tools" { give "sreon://tools" }
    if t == "settings" { give "sreon://settings" }
    if t == "bookmarks" { give "sreon://bookmarks" }
    if t == "vault" { give "sreon://vault" }
    if t == "history" { give "sreon://history" }

    if is_search(t) {
        let base = if search_base != "" { search_base } else { "https://duckduckgo.com/html/?q=" }
        give base + t.replace(" ", "+")
    }

    if not t.contains("://") {
        give "https://" + t
    }
    give t
}
